POSTGRES_PASSWORD=change-this-to-a-long-unique-password
DATABASE_URL=postgresql+psycopg://signalharbor:change-this-to-a-long-unique-password@localhost:5432/signalharbor
ADMIN_EMAIL=admin@signalharbor.local
ADMIN_PASSWORD=change-this-password-before-using
COOKIE_SECURE=false
INGEST_RATE_PER_MIN=2400
MAX_REQUEST_BYTES=1048576
# Opt-in public status: comma-separated service IDs (empty = none)
PUBLIC_STATUS_SERVICE_IDS=

# Number of durable outbox tasks handled in one worker transaction (1-500)
WORKER_BATCH_SIZE=250

# Optional TOTP MFA: generate with Python after installing requirements:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep this key stable, secret, and backed up; changing it locks out enrolled users.
MFA_ENCRYPTION_KEY=
